# PayPilot AI Environment Variables

# PayPal Developer Sandbox Configuration
PAYPAL_CLIENT_ID=sb-demo-client-id
PAYPAL_CLIENT_SECRET=sb-demo-client-secret
PAYPAL_WEBHOOK_ID=demo-webhook-id
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# AI Model Configuration (OpenAI API)
OPENAI_API_KEY=sk-demo-openai-key
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_URL="file:./dev.db"

# Application Security & Auth
JWT_SECRET=paypilot-super-secret-jwt-key-secure-2026-hackathon
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (Auto-seed demo merchant & enable sandbox fallback test transactions)
DEMO_MODE=true
